platform :ios, '15.0'

target 'ServiceSysterm' do

    
    
     pod 'Masonry'
    
     pod 'AFNetworking'
     pod 'MJExtension'
     pod 'MJRefresh'
    
     pod 'SVProgressHUD'
     pod 'IQKeyboardManager'
     #pod 'HTHorizontalSelectionList'

    # pod 'SDWebImage'
    pod 'YYCache'
    #pod 'Pgyer'
         
      pod 'JCore', '2.1.4-noidfa' 
      pod 'JPush', '3.2.4-noidfa'
     
      end
# post_install 钩子：在 pod install 完成后执行
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 获取当前的部署目标版本
      current_deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      
      # 如果当前版本低于指定版本（例如 13.0），则强制修改为 13.0
      # 你可以将 '13.0' 改为你项目实际需要的最低版本，如 '12.0', '14.0' 等
      if current_deployment_target.to_f < 13.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end
